server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Dùng DNS nội bộ của Docker + biến để nginx phân giải lại tên "gateway" mỗi 10s
  # (nếu không, khi container gateway được tạo lại với IP mới, nginx sẽ trả 502)
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
  set $gateway_upstream http://${GATEWAY_HOST};

  # API + media -> API Gateway (stream thẳng, không giới hạn kích thước upload)
  location ~ ^/(api|media)/ {
    proxy_pass $gateway_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA: mọi đường dẫn khác trả về index.html
  location / {
    try_files $uri /index.html;
  }
}
