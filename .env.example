# ===== Cấu hình chạy LOCAL (copy thành .env) =====
NODE_ENV=development

# Bắt buộc. Đổi thành chuỗi ngẫu nhiên dài khi deploy (vd: openssl rand -hex 32)
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d

# Hạ tầng (docker compose up -d mongo rabbitmq mailpit)
MONGO_URL=mongodb://localhost:27017
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Lưu trữ file: local (thư mục chung, mặc định) hoặc s3 (Cloudflare R2 / AWS S3 / SeaweedFS...)
STORAGE_DRIVER=local
STORAGE_DIR=storage
# Khi STORAGE_DRIVER=s3 (thử local: docker compose --profile s3 up -d s3, rồi tạo bucket)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Khi deploy: URL public của gateway (dùng để tạo URL ảnh tuyệt đối, Google/VNPay callback)
GATEWAY_PUBLIC_URL=
# Khi deploy: bí mật chung gateway <-> service; service từ chối request không đi qua gateway
INTERNAL_TOKEN=

# Địa chỉ frontend (dùng cho link reset mật khẩu, redirect thanh toán, Google OAuth)
FRONTEND_URL=http://localhost:5173

# Cổng các service
GATEWAY_PORT=8080
USER_SERVICE_PORT=4001
VIDEO_SERVICE_PORT=4002
STREAMING_SERVICE_PORT=4003
COMMENT_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005

# Gateway -> service (khi chạy bằng Node trên máy)
USER_SERVICE_URL=http://localhost:4001
VIDEO_SERVICE_URL=http://localhost:4002
STREAMING_SERVICE_URL=http://localhost:4003
COMMENT_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
CORS_ORIGINS=http://localhost:5173

# Tài khoản admin tạo sẵn khi user-service khởi động lần đầu
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Quản trị viên

# Email (Mailpit chạy local: xem thư tại http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MiniYTB <no-reply@local.test>"

# Hoặc gửi email qua Brevo HTTP API (khi nền tảng chặn cổng SMTP, vd Render gói free)
BREVO_API_KEY=

# Google OAuth (tuỳ chọn) - để trống thì nút Google bị ẩn
# Callback mặc định: <GATEWAY_PUBLIC_URL hoặc FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Video
MAX_UPLOAD_MB_FREE=500
MAX_UPLOAD_MB_PREMIUM=4096
# true = video tự duyệt sau khi chuyển mã xong; false = chờ admin duyệt
AUTO_APPROVE_VIDEOS=false

# Streaming (ffmpeg phải có trong PATH hoặc khai báo đường dẫn)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Độ phân giải tối đa cho tài khoản free / khách (premium xem được tất cả)
FREE_MAX_HEIGHT=720
# Bậc chất lượng cao nhất worker tạo ra (giảm khi máy yếu) & số luồng ffmpeg (0 = tự động)
MAX_RENDITION_HEIGHT=1080
FFMPEG_THREADS=0
# Preset x264: ultrafast | veryfast | medium (chậm hơn nhưng nén tốt hơn)
FFMPEG_PRESET=veryfast
# api | worker | all  (tách worker chuyển mã ra để scale riêng)
STREAMING_MODE=all
KEEP_RAW_VIDEO=false

# Thanh toán: mock (giả lập, mặc định) hoặc vnpay (sandbox)
PAYMENT_MOCK_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Return URL mặc định: <GATEWAY_PUBLIC_URL hoặc FRONTEND_URL>/api/payments/vnpay/return
